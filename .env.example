# UApiPro 服务端配置。API Key 可选；留空时使用访客额度。
UAPI_API_BASE_URL=https://uapis.cn/api/v1
UAPI_API_KEY=

# 模块默认值
TOOLBOX_DEFAULT_WEATHER_CITY=上海
TOOLBOX_DEFAULT_TIMEZONE=Asia/Shanghai

# 本机数据库目录。留空时使用项目根目录下的 data/。
TOOLBOX_DATA_DIR=

# 可选：用于加密模型渠道 API Key。留空时会在 data/ 自动生成本机密钥文件。
MODEL_TESTER_DATABASE_KEY=

# Modal Volume 网盘。先部署 modal/modal_drive.py，再填写 Modal Web Function URL。
MODAL_DRIVE_API_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# 可选：为网页端网盘增加独立访问密码，验证后使用 HttpOnly Cookie。
MODAL_DRIVE_ACCESS_PASSWORD=

# 仅用于可信的本地模拟服务测试；生产环境请保持 false。
MODAL_DRIVE_ALLOW_LOCAL_API=false
