# Website
WEB_PORT=3000
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Modal Drive: use "local" for development, "modal" in production.
DRIVE_STORAGE_BACKEND=local
DRIVE_MODAL_VOLUME_NAME=modal-drive-storage
DRIVE_MODAL_APP_NAME=modal-drive
DRIVE_MODAL_ENVIRONMENT=
# URL printed for the download_gateway function after `modal deploy`.
DRIVE_MODAL_DOWNLOAD_URL=
# Generate with: openssl rand -hex 32
DRIVE_DOWNLOAD_SIGNING_KEY=
DRIVE_DOWNLOAD_LINK_TTL_SECONDS=300
DRIVE_API_TOKEN=

# Modal supports token credentials directly inside containers.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
